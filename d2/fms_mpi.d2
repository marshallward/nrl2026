style.fill: transparent
direction: right

GPU1 {
    near: center-left
    style.font-color: white
    style.fill: lightsteelblue
    compute {
        label: Compute domain
        style.3d: true
        shape: square
    }
    compute -> buffer
}


# RAM1 {
# }
# 
# RAM2 {
# }

RAM {
}

GPU2 {
    near: center-right
    style.font-color: white
    style.fill: lightsteelblue
    direction: up

    compute {
        label: Compute domain
        style.3d: true
        shape: square
    }
    buffer -> compute
}

GPU1.buffer -> GPU2.buffer: NVLink {
    style.stroke: white
    style.stroke-width: 6
    style.font-color: white
    style.animated: true
}

GPU1.buffer -> RAM: PCIe {
    style.stroke: white
    style.font-color: white
    style.animated: true
}

# RAM1 -> RAM2: PCIe {
#     style.stroke: white
#     style.font-color: white
#     style.animated: true
# }

RAM-> GPU2.buffer: PCIe {
    style.stroke: white
    style.font-color: white
    style.animated: true
}
